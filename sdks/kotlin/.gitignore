# Bau-Ausgaben eines lokalen `gradlew`-Laufs (Docker-only ist die Vorgabe;
# dieser Eintrag schützt nur gegen einen versehentlich lokal gestarteten
# Host-Bau), analog examples/kotlin/.gitignore.
.gradle/
build/

# Host-seitiger Export-Zielort von `make sdk-pack-kotlin`
# (tools/harness/sdk-pack-kotlin.sh) — die erzeugten .jar-Dateien sind
# Bau-Erzeugnisse, kein Bestand.
dist/
