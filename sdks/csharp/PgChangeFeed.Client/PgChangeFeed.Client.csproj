<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PgChangeFeed.Client</RootNamespace>
    <AssemblyName>PgChangeFeed.Client</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- NuGet-Metadaten (ADR-0106 Festlegung 2/3, Slice-DoD): dieses Projekt
       ist ein eigenständiges, veröffentlichbares Package, kein Beispiel wie
       examples/csharp/* (SPEC-023 bleibt Vorbild, kein Belegträger). Version
       startete bei 0.1.0 (ADR-0106 Festlegung 3, unabhängig von
       docs/user/version.md) und wurde auf 0.2.0 gehoben
       (slice-sdk-csharp-nats-stream-client-flaeche): additive, rückwärts-
       kompatible Erweiterung um die SSE- und NATS-Vollinhalts-Client-Fläche,
       kein Breaking Change an HTTP-/gRPC-Fläche — Pflege bei jedem Release
       ein bewusster Schritt, keine automatische Ableitung. -->
  <PropertyGroup>
    <PackageId>PgChangeFeed.Client</PackageId>
    <Version>0.2.0</Version>
    <Authors>pt9912</Authors>
    <Description>Official .NET client library for PG Change Feed (HTTP API, gRPC change stream, SSE stream, and NATS full-content stream).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pt9912/pg-change-feed</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pt9912/pg-change-feed</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- README.md liegt eine Ebene höher (sdks/csharp/README.md, DoD dieses
       Slice) — Sprachwurzel-Ebene, analog dem Dockerfile/
       Directory.Packages.props dieses Bau-Kontexts, statt je Package
       dupliziert. Der explizite PackagePath legt sie im .nupkg trotzdem an
       die Wurzel, wo PackageReadmeFile sie erwartet. -->
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <!-- Der SDK-Style-Glob nimmt sonst auch die Testquellen des Unterordners
       auf (PgChangeFeed.Client.Tests/ liegt innerhalb dieses
       Projektverzeichnisses) — das Testprojekt referenziert diese Klassen
       bereits über ProjectReference, analog examples/csharp/http-client. -->
  <ItemGroup>
    <Compile Remove="PgChangeFeed.Client.Tests/**" />
  </ItemGroup>

  <!-- Grpc.Net.Client trägt die Laufzeit, Google.Protobuf die Nachrichtenform;
       Grpc.Tools (nur Build-Zeit, PrivateAssets) trägt protoc und das
       C#-Plugin, das den Stub unten aus der `.proto` erzeugt
       (slice-sdk-csharp-grpc-client-flaeche, ADR-0106 Festlegung 1/2, Muster
       examples/csharp/grpc-client/grpc-client.csproj). -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <!-- NATS.Net trägt die NATS-Vollinhalts-Client-Fläche
       (slice-sdk-csharp-nats-stream-client-flaeche, SPEC-024,
       ADR-0106 §Entscheidung Festlegung 1 letzter Absatz). -->
  <ItemGroup>
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

  <!-- Die `.proto` selbst liegt NICHT in diesem Verzeichnis — sie kommt erst
       im Docker-Bau hierher, kopiert aus dem zusätzlichen, benannten
       Bau-Kontext `proto` (sdks/csharp/Dockerfile, ADR-0106 Festlegung 2,
       Muster examples/csharp/Dockerfile). Dieser Pfad existiert deshalb nur
       innerhalb des Baus, nicht im committeten Baum — kein committeter
       Stub, keine committete Kopie der `.proto`. -->
  <ItemGroup>
    <Protobuf Include="Grpc/proto/changestream.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
