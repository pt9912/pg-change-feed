<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PgChangeFeed.Client</RootNamespace>
    <AssemblyName>PgChangeFeed.Client</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet metadata: this project is a standalone, publishable package. The
       version is set here by hand at each release, independent of the server
       version. Description, PackageTags and the README (PackageReadmeFile) are
       the fields users see on NuGet.org. The XML documentation file
       (GenerateDocumentationFile) ships with the package so that IDEs show the
       API comments. -->
  <PropertyGroup>
    <PackageId>PgChangeFeed.Client</PackageId>
    <Version>0.2.1</Version>
    <Authors>pt9912</Authors>
    <Description>Official .NET client library for PG Change Feed (HTTP API, gRPC change stream, SSE stream, and NATS full-content stream).</Description>
    <PackageTags>postgresql;change-data-capture;cdc;logical-replication;change-feed</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pt9912/pg-change-feed</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pt9912/pg-change-feed</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The README lives one level up (sdks/csharp/README.md), at the language
       root next to the Dockerfile and Directory.Packages.props, instead of
       being duplicated per package. The explicit PackagePath places it at the
       root of the .nupkg, where PackageReadmeFile expects it. -->
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <!-- The SDK-style glob would otherwise include the test sources of the
       subfolder (PgChangeFeed.Client.Tests/ lies inside this project
       directory); the test project references these classes through a
       ProjectReference. -->
  <ItemGroup>
    <Compile Remove="PgChangeFeed.Client.Tests/**" />
  </ItemGroup>

  <!-- Grpc.Net.Client carries the runtime, Google.Protobuf the message form;
       Grpc.Tools (build time only, PrivateAssets) carries protoc and the C#
       plugin that generates the stub below from the `.proto`. -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <!-- NATS.Net carries the NATS client. -->
  <ItemGroup>
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

  <!-- The `.proto` itself is not in this directory: the Docker build copies it
       here from the additional named build context `proto`
       (sdks/csharp/Dockerfile). The path therefore exists only inside the
       build, not in the committed tree: no committed stub, no committed copy
       of the `.proto`. -->
  <ItemGroup>
    <Protobuf Include="Grpc/proto/changestream.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
