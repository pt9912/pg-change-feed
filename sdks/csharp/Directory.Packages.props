<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Pinned package versions: exact versions, no ranges. The same versions
       as the example tree (examples/csharp/Directory.Packages.props, measured
       2026-09-17); the three packages carry only the test run (xUnit). Raising
       a pin is a deliberate commit, not a silent resolution. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <!-- gRPC and protobuf toolchain of the gRPC client: the stub is generated
       during the build from the `.proto` read through the additional named
       build context and is not in the committed tree. Latest stable versions,
       measured 2026-09-19 (api.nuget.org/v3-flatcontainer/<package>/index.json,
       last entry without a `-pre`/`-rc` suffix):
       - Grpc.Net.Client (gRPC runtime, `GrpcChannel`/`CallInvoker`): 2.83.0
         (2.84.0-pre1 is the only 2.84.0 line at that time and a prerelease,
         no candidate)
       - Grpc.Tools (build time only, PrivateAssets — carries protoc and the
         C# plugin that generate the stub): 2.84.0 — the same as examples/csharp
       - Google.Protobuf (message runtime for the generated types): 3.36.2 —
         one line newer than examples/csharp's 3.36.1 of 2026-09-17; 4.0.0-rc2
         is a prerelease at that time and therefore no candidate. -->
  <ItemGroup>
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
  </ItemGroup>

  <!-- NATS.Net: the pinned, public client library of the NATS stream client.
       Meta package, measured 2026-09-22:
       `api.nuget.org/v3-flatcontainer/nats.net/index.json` lists `3.2.0` as
       the latest stable version (the same as examples/csharp's `3.2.0` of
       2026-09-17). For net10.0 it pulls in only its own (NATS.Client.*) and
       Microsoft.Extensions.* packages transitively. -->
  <ItemGroup>
    <PackageVersion Include="NATS.Net" Version="3.2.0" />
  </ItemGroup>

</Project>
