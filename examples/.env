# Demo-Zugangsdaten, gültig ausschließlich im isolierten Docker-Netzwerk
# `cdc-examples` — niemals gegen eine Produktionsinstanz verwenden.
#
# Committet statt Vorlage (ADR-0098 Festlegung 3): diese Datei trägt keine
# echten Secrets, nur Demo-Werte für die durch das Docker-Netzwerk
# `cdc-examples` isolierte Umgebung aus examples/compose.yaml — dieselbe
# Klasse von Klartext-Demo-Werten, die die Wurzel-compose.yaml bereits
# committet führt. Adressen stehen als Compose-Servicenamen, nicht als
# `localhost` (ADR-0098 Festlegung 4): sowohl examples/compose.yaml
# (`env_file:`, pg-change-feed-Dienst) als auch jedes `make
# example-run-*`-Ziel (`--env-file`) lesen genau diese Datei — eine Quelle
# der Wahrheit statt doppelt geführter Werte. Variablennamen sind die
# bereits in docs/user/benutzerhandbuch.md §5 dokumentierten `CDC_*`-Namen,
# keine Demo-spezifischen Erfindungen.

# Drei rollenspezifische DSNs (ADR-0047) — die Demo-Umgebung verbindet sich
# wie die Wurzel-compose.yaml mit dem Superuser `postgres`, weil sie keine
# eigenen Login-Identitäten je Least-Privilege-Rolle anlegt.
CDC_CAPTURE_DSN=postgres://postgres:postgres@postgres:5432/cdc?sslmode=disable
CDC_ADMIN_DSN=postgres://postgres:postgres@postgres:5432/cdc?sslmode=disable
CDC_READER_DSN=postgres://postgres:postgres@postgres:5432/cdc?sslmode=disable

# Demo-Quelle/-Tabelle: examples/bootstrap.sh registriert cdc.source und
# legt public.orders mit einer Demo-Zeile an; der Feed-Container aktiviert
# die Tabelle beim eigenen Start automatisch über CDC_TABLES (ADR-0028).
CDC_SOURCE_ID=demo-source
CDC_PUBLICATION=pub_demo
CDC_SLOT=slot_demo
CDC_TABLES=public.orders=tbl-orders:sv-orders-1

# Optionales Wecksignal (ADR-0055) — dieselbe URL liest der Feed-Container
# und der nats-client (CDC_NATS_URL). Seit ADR-0100 verlangt der nats-Service
# (examples/compose.yaml, --auth) serverweit einen Verbindungs-Token — die
# URL trägt ihn eingebettet (nats://<token>@host:4222), damit der bereits
# ausgelieferte nats-client (der keine eigene Token-Option kennt) unverändert
# funktioniert. Der Feed-Container selbst trägt denselben Wert zusätzlich
# separat über CDC_NATS_STREAM_TOKEN (siehe unten); ein expliziter
# Verbindungs-Options-Wert schlägt dabei einen eingebetteten URL-Token, kein
# Konflikt zwischen beiden Formen.
CDC_NATS_URL=nats://demo-nats-stream-token@nats:4222

# Dritter, vollinhaltstragender NATS-Zustellweg (ADR-0100, LH-FA-SST-008):
# gesetzt zusammen mit CDC_NATS_URL — aktiviert den natsstream.Publisher im
# Feed-Container (Subjekt-Namensraum cdc.stream.<...>). Ein künftiger
# nats-stream-client (Beispiel-Client-Folge-Slice) liest denselben Wert.
CDC_NATS_STREAM_TOKEN=demo-nats-stream-token

# Connect-Form für externe Clients (Compose-Servicename, nicht localhost —
# ADR-0098 Festlegung 4). Der Feed-Container selbst überschreibt diese
# zwei Variablen in examples/compose.yaml mit einer Bind-Adresse
# (":8090"/":9090"); die hier stehende Form gilt für jeden, der sich als
# Client gegen die Demo-Umgebung verbindet (make example-run-*,
# docker run --network cdc-examples).
CDC_HTTP_ADDR=pg-change-feed:8090
CDC_GRPC_ADDR=pg-change-feed:9090

CDC_API_TOKEN_READER=demo-reader-token
CDC_API_TOKEN_ADMIN=demo-admin-token

CDC_LOG_LEVEL=info
