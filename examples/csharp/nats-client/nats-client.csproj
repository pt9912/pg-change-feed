<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CdcExamples.Nats</RootNamespace>
    <AssemblyName>nats-client</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Der SDK-Style-Glob nimmt sonst auch die Testquellen des Unterordners
       auf (NatsClient.Tests/ liegt innerhalb dieses Projektverzeichnisses) —
       das Testprojekt referenziert diese Klassen bereits über
       ProjectReference. Muster: examples/csharp/http-client/http-client.csproj. -->
  <ItemGroup>
    <Compile Remove="NatsClient.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

</Project>
