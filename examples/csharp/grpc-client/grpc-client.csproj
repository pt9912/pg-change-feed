<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CdcExamples.Grpc</RootNamespace>
    <AssemblyName>grpc-client</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Der SDK-Style-Glob nimmt sonst auch die Testquellen des Unterordners
       auf (GrpcClient.Tests/ liegt innerhalb dieses Projektverzeichnisses) —
       das Testprojekt referenziert diese Klassen bereits über
       ProjectReference. Muster: examples/csharp/http-client/http-client.csproj. -->
  <ItemGroup>
    <Compile Remove="GrpcClient.Tests/**" />
  </ItemGroup>

  <!-- Grpc.Net.Client trägt die Laufzeit, Google.Protobuf die Nachrichtenform;
       Grpc.Tools (nur Build-Zeit, PrivateAssets) trägt protoc und das
       C#-Plugin, das den Stub unten aus der `.proto` erzeugt (ADR-0090
       Festlegung 2/4). -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <!-- Die `.proto` selbst liegt NICHT in diesem Verzeichnis — sie kommt erst
       im Docker-Bau hierher, kopiert aus dem zusätzlichen, benannten
       Bau-Kontext `proto` (examples/csharp/Dockerfile, ADR-0090
       Festlegung 2). Dieser Pfad existiert deshalb nur innerhalb des Baus,
       nicht im committeten Baum (ADR-0090 Festlegung 3 — kein committeter
       Stub, keine committete Kopie der `.proto`). -->
  <ItemGroup>
    <Protobuf Include="proto/changestream.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
