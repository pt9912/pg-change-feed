<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Gepinnte Paketversionen (ADR-0087 Festlegung 3, ADR-0090 Festlegung 4):
       exakte Versionen, keine Bereiche — dasselbe Prinzip wie die
       Digest-Pinnung der Basis-Images im Dockerfile. Pin-Hebung ist ein
       bewusster Commit, keine stille Auflösung. Diese drei Pakete tragen
       ausschließlich den Testlauf (xUnit); http-client und sse-client
       brauchen kein Fremdmodul — sie lesen JSON/HTTP aus der .NET-Runtime. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <!-- NATS.Net: die gepinnte, öffentliche Client-Bibliothek des
       nats-client-Programms (ADR-0090 Festlegung 4, LP1 des Slice-Plans) —
       Abonnement des Wecksignal-Subjekts, zweiseitiger Ablauf
       (ADR-0055/ADR-0056/ADR-0079). Meta-Paket, gemessen am 2026-09-17
       (NuGet v3-flatcontainer/registration5-semver1
       api.nuget.org/v3/catalog0/…/nats.net.3.2.0.json): neueste stabile
       Version 3.2.0 (kein Prerelease, isPrerelease=false), Ziel-Framework
       net10.0. Für net10.0 zieht es transitiv ausschließlich eigene
       (NATS.Client.*) und Microsoft.Extensions.*-Pakete nach — keine
       zusätzliche, eigenständig zu bewertende Fremdabhängigkeit (anders als
       beim Kotlin-Pendant, siehe
       examples/kotlin/nats-client/build.gradle.kts). -->
  <ItemGroup>
    <PackageVersion Include="NATS.Net" Version="3.2.0" />
  </ItemGroup>

  <!-- gRPC-/Protobuf-Werkzeugkette des grpc-client-Programms (ADR-0090
       Festlegung 2/4, slice-102) — der Stub entsteht im Bau aus der über den
       benannten Zusatzkontext gelesenen `.proto`, liegt nicht im committeten
       Baum. Neueste stabile Versionen, gemessen am 2026-09-17
       (api.nuget.org/v3-flatcontainer/<paket>/index.json, jeweils letzter
       Eintrag ohne `-pre`/`-rc`-Suffix — deckungsgleich mit den in ADR-0090
       §Entscheidung Festlegung 4 gemessenen Kandidaten):
       - Grpc.Net.Client (gRPC-Laufzeit, `GrpcChannel`): 2.83.0
       - Grpc.Tools (nur Build-Zeit, PrivateAssets — trägt protoc und das
         C#-Plugin, die den Stub erzeugen): 2.84.0
       - Google.Protobuf (Nachrichten-Laufzeit für die erzeugten Typen):
         3.36.1 (die nächste Zeile, 4.0.0, ist zum Messzeitpunkt Prerelease
         (`-rc1`) und deshalb kein Kandidat, AGENTS.md §3.12). -->
  <ItemGroup>
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.1" />
  </ItemGroup>

</Project>
