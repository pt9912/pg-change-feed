{
    "permissions": {
        "allow": [
            "Bash(make:*)",
            "Bash(make)",
            "Bash(git status:*)",
            "Bash(git log:*)",
            "Bash(git diff:*)",
            "Bash(git show:*)",
            "Bash(git mv:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git push --force-with-lease origin main)",
            "Bash(git worktree list)",
            "Bash(docker manifest inspect:*)",
            "Bash(docker buildx imagetools inspect:*)",
            "Bash(ls:*)",
            "Bash(grep:*)",
            "Bash(find:*)",
            "Bash(cat:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(wc:*)",
            "Bash(diff:*)",
            "Bash(sed -n:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/span-emit.sh",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/span-emit.sh",
                        "timeout": 5
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/span-emit.sh",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pretooluse-command-guard.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-require-gates.sh"
                    }
                ]
            }
        ]
    }
}
